# Shared edge for sandbox projects.
# TLS via Cloudflare Origin Certificate (keeps zone SSL mode Full / Full Strict).
{
	email {$CADDY_EMAIL:admin@didiktrisusanto.dev}
}

sandbox.didiktrisusanto.dev {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	respond "sandbox-infra caddy is up" 200
}

